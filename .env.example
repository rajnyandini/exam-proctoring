# ==============================================================
# Exam Proctoring System - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# --- Workstation Identification (Multi-Device Proctoring) ---
# Give each candidate laptop/device a unique identifier (e.g. DESK-01, DESK-02)
DEVICE_ID=DESK-01
CANDIDATE_NAME=Candidate 01

# --- Camera Settings (Native Laptop Camera or External USB Webcam) ---
# Camera selection mode:
#   - 'native': Forces built-in laptop camera (Index 0)
#   - 'external': Prioritizes external USB webcam (Index 1/2), with graceful fallback to native
#   - 'auto': Probes configured CAMERA_INDEX, then automatically searches native and external cameras
#   - '0', '1', '2': Specific hardware index
CAMERA_SOURCE=auto
CAMERA_INDEX=0
# If true, auto-probes native and external camera indices if the specified camera fails
CAMERA_AUTO_DETECT=true
CAMERA_BACKEND=AVFOUNDATION
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=15
# Send base64 JPEG thumbnail of the student/incident to the Raspberry Pi during an alert
EVIDENCE_THUMBNAIL_ON_ALERT=true

# --- Proctoring Thresholds (seconds) ---
FACE_ABSENCE_THRESHOLD_SEC=5.0
MULTIPLE_FACES_THRESHOLD_SEC=2.0

# --- Storage Paths ---
EVIDENCE_DIR=evidence
DATA_DIR=data
DB_PATH=data/proctoring.db

# --- Dashboard Server ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001
SECRET_KEY=change-this-to-a-secure-random-secret-key

# --- Raspberry Pi Integration ---
# Keep PI_ENABLED=false until Raspberry Pi is configured and on local network
PI_ENABLED=false
PI_BASE_URL=http://raspberrypi.local:5050
PI_SHARED_TOKEN=replace_with_a_secure_random_hex_string
PI_TIMEOUT_SEC=2.0

# --- Raspberry Pi Servo Hardware (Only used on Raspberry Pi agent) ---
# DANGER: Keep SERVO_ENABLED=false until motor model, wiring, and power supply are verified!
SERVO_ENABLED=false
SERVO_DRY_RUN=true
SERVO_PIN=18
SERVO_MIN_PULSE_MS=1.0
SERVO_MAX_PULSE_MS=2.0
SERVO_FREQUENCY_HZ=50

# --- Optional Experimental Features ---
HEAD_POSE_ENABLED=false
